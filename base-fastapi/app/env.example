# WEBAPP
HOST=0.0.0.0
PORT=8989
WORKERS_COUNT=1
RELOAD=False

# LOG
LOG_LEVEL=INFO
ENVIRONMENT=dev


# Gunicorn
LIMIT_CONCURRENCY=1000
TIMEOUT_KEEP_ALIVE=20
TIMEOUT=70
GRACEFUL_TIMEOUT=20
MAX_REQUESTS=3000
MAX_REQUESTS_JITTER=30
PRELOAD_APP=True
REUSE_PORT=True

# Mongo
MONGO_DB={{db_name}}
MONGO_URI=mongodb://{{user_name}}:{{user_password}}@{{host_ip}}:{{port}}/{{db_name}}
POOL_SIZE=100

# DATABASE
USE_PGBOUNCER=False

DB_HOST={{host_ip}}
DB_PORT={{port}}
DB_USER={{user_name}}
DB_NAME={{db_name}}
DB_PASS={{password}}


DB_READ_HOST={{read_host_ip}}
DB_READ_PORT={{read_port}}
DB_READ_USER={{user_name}}
DB_READ_NAME={{db_name}}
DB_READ_PASS={{read_password}}

DB_ECHO=False

# CONNECTOR
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE_CONNECTIONS=50
HTTP_POOL_TIMEOUT_SECONDS=5.0
HTTP_MAX_CONCURRENT_REQUESTS=100

# MONITORING
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
OPENTELEMETRY_ENDPOINT=
OPENTELEMETRY_INSECURE=False

# Security
ALLOWED_HOSTS={{allowed_hosts}}
DOCS_ENABLED=True
METRICS_ENABLED=True

# Request/log limits
MAX_REQUEST_BODY_BYTES=2097152
MAX_LOG_BODY_BYTES=16384



# REDIS
REDIS_HOST={{redis_host_ip}}
REDIS_PORT={{redis_port}}
REDIS_USER={{redis_user_name}}
REDIS_PASS={{redis_password}}
REDIS_BASE={{redis_db}}

# Celery Configuration
CELERY_DEFAULT_QUEUE={{celery_queue}}


# Rate limit
RATE_LIMIT_ENABLED=False
RATE_LIMIT_BY_IP_ENABLED=False
RATE_LIMIT_IP_REQUESTS=120
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_BY_CLIENT_ID_ENABLED=False
RATE_LIMIT_CLIENT_ID_REQUESTS=300
RATE_LIMIT_CLIENT_ID_WINDOW_SECONDS=60
RATE_LIMIT_CLIENT_ID_HEADER=x-client-id
RATE_LIMIT_TRUST_PROXY_HEADERS=False
