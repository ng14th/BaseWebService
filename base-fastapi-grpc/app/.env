# WEBAPP
HOST=0.0.0.0
PORT=8989
WORKERS_COUNT=1
RELOAD=False

# LOG
LOG_LEVEL=INFO
ENVIRONMENT=dev


# Gunicorn
LIMIT_CONCURRENCY=1000
TIMEOUT_KEEP_ALIVE=20
TIMEOUT=70
GRACEFUL_TIMEOUT=20
MAX_REQUESTS=3000
MAX_REQUESTS_JITTER=30
PRELOAD_APP=True
REUSE_PORT=True

# Mongo
MONGO_DB=onflow-tms-system
MONGO_URI=mongodb://tms_user:tms_password@127.0.0.1:27017/onflow-tms-system
POOL_SIZE=100

# DATABASE
USE_PGBOUNCER=True

DB_HOST=localhost
DB_PORT=6432
DB_USER=app
DB_NAME=app
DB_PASS=app_password

DB_READ_HOST=localhost
DB_READ_PORT=6433
DB_READ_USER=app
DB_READ_NAME=app
DB_READ_PASS=app_password

DB_ECHO=False

# CONNECTOR
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE_CONNECTIONS=50
HTTP_POOL_TIMEOUT_SECONDS=5.0
HTTP_MAX_CONCURRENT_REQUESTS=100

# MONITORING
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0
OPENTELEMETRY_ENDPOINT=


# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_BASE=0

# Celery Configuration
CELERY_TMS_DEFAULT_QUEUE=onflow-e-invoice-queue-tasks


# Rate limit
RATE_LIMIT_ENABLED=False
RATE_LIMIT_BY_IP_ENABLED=False
RATE_LIMIT_IP_REQUESTS=120
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_BY_CLIENT_ID_ENABLED=False
RATE_LIMIT_CLIENT_ID_REQUESTS=300
RATE_LIMIT_CLIENT_ID_WINDOW_SECONDS=60
RATE_LIMIT_CLIENT_ID_HEADER=x-client-id
RATE_LIMIT_TRUST_PROXY_HEADERS=False
