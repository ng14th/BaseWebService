        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 39 },
      "id": 32,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["mean"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "avg(probe_duration_seconds{job=\"blackbox_http_50020\"})",
          "legendFormat": "Avg Response",
